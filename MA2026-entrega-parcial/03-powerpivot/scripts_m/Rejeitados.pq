// Rejeitados
// Referência à tabela salva da Etapa 2; preserva registros e campos.
let
    Origem = cad_Etapa2{[Item = "Rejeitados", Kind = "Table"]}[Data],
    Tipos = Table.TransformColumnTypes(Origem, {
        {"Base", type text},
        {"Fonte", type text},
        {"Fonte_Dados", type text},
        {"Arquivo_Origem", type text},
        {"Linha_Origem", Int64.Type},
        {"ID_Vaga_Original", type text},
        {"Orgao_Original", type text},
        {"Tipo_Publicacao_Original", type text},
        {"Quantidade_Original", type text},
        {"Titulo_Original", type text},
        {"Cargo_Publico_Original", type text},
        {"Classificacao_Original", type text},
        {"Codigo_Cargo_Original", type text},
        {"Nivel_Original", type text},
        {"Categoria_Original", type text},
        {"Vinculo_Original", type text},
        {"Carreira_Original", type text},
        {"Salario_Min_Original", type text},
        {"Salario_Max_Original", type text},
        {"Frequencia_Original", type text},
        {"Localidade_Original", type text},
        {"Divisao_Original", type text},
        {"Descricao_Original", type text},
        {"Requisitos_Originais", type text},
        {"Habilidades_Originais", type text},
        {"Informacoes_Originais", type text},
        {"Candidatura_Original", type text},
        {"Horario_Original", type text},
        {"Localidade_Detalhe_Original", type text},
        {"Contato_Original", type text},
        {"Residencia_Exigida_Original", type text},
        {"Publicacao_Original", type text},
        {"Limite_Original", type text},
        {"Atualizacao_Original", type text},
        {"Processamento_Original", type text},
        {"Moeda_Original", type text},
        {"Cultura_Numerica", type text},
        {"Modalidade_Original", type text},
        {"Hora_Atendimento", type text},
        {"ID_Cenario", type text},
        {"ID_Registro_FaseI", type text},
        {"Linha_FaseI", Int64.Type},
        {"Motivo", type text},
        {"Cargo_Original", type text},
        {"Experiencia_Original", type text},
        {"Ano_Original", type text},
        {"Residencia_Original", type text},
        {"Salario_Original", type text},
        {"Salario_USD_Original", type text},
        {"Pais_Empresa_Original", type text},
        {"Porte_Original", type text}
    }, "pt-BR")
in
    Tipos
