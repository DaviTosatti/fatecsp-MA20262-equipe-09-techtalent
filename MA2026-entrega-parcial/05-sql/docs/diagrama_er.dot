digraph TechTalent {
  graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.38", ranksep="0.72", splines=ortho, fontname="Arial", labelloc="t", label="TechTalent — Modelo relacional da Etapa 5", fontsize=20];
  node [shape=plain, fontname="Arial"];
  edge [color="#596579", penwidth=1.4, arrowsize=0.75, fontname="Arial", fontsize=9];

  cargo [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dbeafe"><B>tb_dim_cargo</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> cod_cargo</TD></TR><TR><TD ALIGN="LEFT">cargo, categoria</TD></TR><TR><TD ALIGN="LEFT">salario_ref, moeda_ref</TD></TR><TR><TD ALIGN="LEFT">periodicidade_ref</TD></TR></TABLE> >];
  orgao [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dbeafe"><B>tb_dim_orgao</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> cod_orgao</TD></TR><TR><TD ALIGN="LEFT">orgao</TD></TR></TABLE> >];
  calendario [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dbeafe"><B>tb_dim_calendario</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> data</TD></TR><TR><TD ALIGN="LEFT">ano, mes, nome_mes, ano_mes</TD></TR><TR><TD ALIGN="LEFT">mes_inicio, trimestre, dia_semana</TD></TR><TR><TD ALIGN="LEFT">nome_dia, fim_de_semana, feriado</TD></TR></TABLE> >];
  vagas [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dcfce7"><B>tb_fato_vagas</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> id_registro_fase1</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> cod_cargo, cod_orgao</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> data_publicacao</TD></TR><TR><TD ALIGN="LEFT">fonte, id_vaga, quantidade</TD></TR><TR><TD ALIGN="LEFT">faixa salarial, moeda e periodicidade</TD></TR><TR><TD ALIGN="LEFT">texto, habilidades, linhagem</TD></TR></TABLE> >];

  cargo_sal [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dbeafe"><B>tb_dim_cargo_salarios</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> cod_cargo_salarial</TD></TR><TR><TD ALIGN="LEFT">cargo</TD></TR></TABLE> >];
  pais [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dbeafe"><B>tb_pais</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> cod_pais</TD></TR><TR><TD ALIGN="LEFT">pais</TD></TR></TABLE> >];
  ano [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dbeafe"><B>tb_dim_ano</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> ano</TD></TR></TABLE> >];
  salarios [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dcfce7"><B>tb_fato_salarios</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> id_registro_fase1</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> cod_cargo_salarial, ano</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> cod_pais_empresa</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> cod_pais_residencia</TD></TR><TR><TD ALIGN="LEFT">salario, moeda, salario_usd</TD></TR><TR><TD ALIGN="LEFT">experiencia, vinculo, periodicidade</TD></TR></TABLE> >];

  metas [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#dcfce7"><B>tb_fato_metas</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> fonte + cod_orgao + ano_mes</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> cod_orgao, mes_inicio</TD></TR><TR><TD ALIGN="LEFT">meta_contratacoes (simulada)</TD></TR></TABLE> >];

  rejeitados [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6">
    <TR><TD BGCOLOR="#fef3c7"><B>tb_rejeitado</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B> base + id_registro_fase1</TD></TR><TR><TD ALIGN="LEFT">valores originais + motivo</TD></TR><TR><TD ALIGN="LEFT">sem FKs (auditoria)</TD></TR></TABLE> >];

  cargo -> vagas;
  orgao -> vagas;
  calendario -> vagas;
  orgao -> metas;
  calendario -> metas;
  cargo_sal -> salarios;
  ano -> salarios;
  pais -> salarios;
  pais -> salarios;
  {rank=same; cargo; orgao; calendario;}
  {rank=same; cargo_sal; pais; ano;}
  {rank=same; vagas; metas; salarios; rejeitados;}
}
