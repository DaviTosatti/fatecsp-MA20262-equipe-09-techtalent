// proc_Vagas
let
    Origem = stg_Vagas_Bruto,
    ColunasDados = List.RemoveItems(ColunasAlvo,{"Fonte","Fonte_Dados","ID_Registro_FaseI","Linha_FaseI","Cultura_Numerica"}),
    SemLinhasEmBranco = Table.SelectRows(Origem,each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(Record.SelectFields(_,ColunasDados)),{"",null}))),
    FontesConhecidas = Table.SelectRows(SemLinhasEmBranco,each List.Contains({"NYC","SIMULADO"},[Fonte])),
    SemIDVazio = Table.SelectRows(FontesConhecidas,each [ID_Vaga_Original]<>null and Text.Trim(Text.From([ID_Vaga_Original]))<>""),
    SemQtdNulaZero = Table.SelectRows(SemIDVazio,each [Quantidade_Original]<>null and [Quantidade_Original]<>0),
    OrdemBruta = Table.Buffer(Table.Sort(SemQtdNulaZero,{{"Arquivo_Origem",Order.Ascending},{"Linha_Origem",Order.Ascending}})),
    SemDuplicatasExatas = Table.Distinct(OrdemBruta,{"Fonte","ID_Vaga_Original","Tipo_Publicacao_Original","Publicacao_Original","Hora_Atendimento","Cargo_Publico_Original","Orgao_Original"}),
    ComData = Table.AddColumn(SemDuplicatasExatas,"Data_Publicacao",each fnData([Publicacao_Original]),type nullable date),
    DatasHoras = Table.AddColumn(ComData,"Hora_Atendimento_Tratada",each fnHora([Hora_Atendimento]),type nullable time),
    SemDataInvalida = Table.SelectRows(DatasHoras,each [Data_Publicacao]<>null),
    NoPeriodo = Table.SelectRows(SemDataInvalida,each [Data_Publicacao]>=pDataInicio and [Data_Publicacao]<=pDataFim),
    SemHoraInvalida = Table.SelectRows(NoPeriodo,each [Fonte]<>"SIMULADO" or [Hora_Atendimento_Tratada]<>null),
    ComNumeros = Table.AddColumn(SemHoraInvalida,"Conversao",each [
        Quantidade=fnNumero([Quantidade_Original],[Cultura_Numerica]),
        Salario_Min=fnNumero([Salario_Min_Original],[Cultura_Numerica]),
        Salario_Max=fnNumero([Salario_Max_Original],[Cultura_Numerica])]),
    Numeros = Table.ExpandRecordColumn(ComNumeros,"Conversao",{"Quantidade","Salario_Min","Salario_Max"}),
    SemErrosNumericos = Table.SelectRows(Numeros,each [Quantidade]<>null and [Salario_Min]<>null and [Salario_Max]<>null),
    QuantidadeInteira = Table.SelectRows(SemErrosNumericos,each [Quantidade]=Number.RoundDown([Quantidade])),
    QuantidadePositiva = Table.SelectRows(QuantidadeInteira,each [Quantidade]>0),
    FaixaValida = Table.SelectRows(QuantidadePositiva,each [Salario_Min]>=0 and [Salario_Max]>=[Salario_Min]),
    TiposNumericos = Table.TransformColumnTypes(FaixaValida,{{"Quantidade",Int64.Type},{"Salario_Min",type number},{"Salario_Max",type number}}),
    CategoriaPadronizada = Table.AddColumn(TiposNumericos,"Categoria_Tratada",each if [Categoria_Original]=null then null else Text.Proper(fnLimparTexto(Text.From([Categoria_Original])),"pt-BR"),type nullable text),
    TextosLimpos = Table.AddColumn(CategoriaPadronizada,"Titulo",each fnLimparTexto(if [Titulo_Original]=null then null else Text.From([Titulo_Original])),type nullable text),
    ComOrgaoChave = Table.AddColumn(TextosLimpos,"Chave_Orgao",each [Fonte] & "|" & fnChave([Orgao_Original]),type nullable text),
    ChavesDimensoes = Table.AddColumn(ComOrgaoChave,"Chave_Cargo",each [Fonte] & "|" & (if [Fonte]="NYC" then fnChave([Codigo_Cargo_Original]) else fnChave([Cargo_Publico_Original])),type nullable text),
    MesclaOrgao = Table.NestedJoin(ChavesDimensoes,{"Chave_Orgao"},cad_DeParaOrgao,{"Chave_Orgao"},"CadastroOrgao",JoinKind.LeftOuter),
    ExpandeOrgao = Table.ExpandTableColumn(MesclaOrgao,"CadastroOrgao",{"Cod_Orgao"},{"Cod_Orgao"}),
    ComOrgao = Table.SelectRows(ExpandeOrgao,each [Cod_Orgao]<>null),
    MesclaCargo = Table.NestedJoin(ComOrgao,{"Chave_Cargo"},cad_CargoChave,{"Chave_Cargo"},"CadastroCargo",JoinKind.LeftOuter),
    ExpandeCargo = Table.ExpandTableColumn(MesclaCargo,"CadastroCargo",{"Cod_Cargo","Cargo","Categoria"},{"Cod_Cargo","Cargo","Categoria_Cadastro"}),
    ComCargo = Table.SelectRows(ExpandeCargo,each [Cod_Cargo]<>null),
    ComTipoChave = Table.AddColumn(ComCargo,"Tipo_Publicacao_Chave",each fnChave([Tipo_Publicacao_Original]),type nullable text),
    OrdemOficial = Table.Buffer(Table.Sort(ComTipoChave,{{"Arquivo_Origem",Order.Ascending},{"Linha_Origem",Order.Ascending}})),
    SemDuplicatas = Table.Distinct(OrdemOficial,{"Fonte","ID_Vaga_Original","Tipo_Publicacao_Chave","Data_Publicacao","Hora_Atendimento_Tratada","Cod_Cargo","Cod_Orgao"}),
    ComRotulos = Table.AddColumn(SemDuplicatas,"Rotulos",each [
        ID_Vaga=Text.From([ID_Vaga_Original]),
        Orgao=if [Fonte]="NYC" then fnLimparTexto(Text.From([Orgao_Original])) else dOrgao{[Cod_Orgao=[Cod_Orgao]]}[Orgao],
        Tipo_Publicacao=fnRotuloCadastro([Tipo_Publicacao_Original],cad_Publicacoes),
        Vinculo=fnRotuloCadastro([Vinculo_Original],cad_Vinculos),
        Periodicidade=fnRotuloCadastro([Frequencia_Original],cad_Frequencias),
        Categoria=if [Categoria_Cadastro]<>null then [Categoria_Cadastro] else [Categoria_Tratada],
        Moeda=if [Moeda_Original]=null or fnLimparTexto(Text.From([Moeda_Original]))="" then "Não informada" else Text.Upper(fnLimparTexto(Text.From([Moeda_Original]))),
        Modalidade=if [Modalidade_Original]=null then "Não informada" else fnLimparTexto(Text.From([Modalidade_Original])),
        Localidade=let Valor=fnLimparTexto(if [Localidade_Original]=null then null else Text.From([Localidade_Original])) in if Valor=null or Valor="" then "Não informada" else Valor,
        Localidade_Detalhe=let Valor=fnLimparTexto(if [Localidade_Detalhe_Original]=null then null else Text.From([Localidade_Detalhe_Original])) in if Valor=null or Valor="" then "Não informada" else Valor,
        Horario_Jornada=let Valor=fnLimparTexto(if [Horario_Original]=null then null else Text.From([Horario_Original])) in if Valor=null or Valor="" then "Não informado" else Valor,
        Descricao=if [Descricao_Original]=null then "Não informado" else fnLimparTexto(Text.From([Descricao_Original])),
        Requisitos=if [Requisitos_Originais]=null then "Não informado" else fnLimparTexto(Text.From([Requisitos_Originais])),
        Habilidades=if [Habilidades_Originais]=null then "Não informado" else fnLimparTexto(Text.From([Habilidades_Originais])),
        Atualizacao=fnData([Atualizacao_Original]),
        Limite_Candidatura=fnData([Limite_Original])]),
    Rotulos = Table.ExpandRecordColumn(ComRotulos,"Rotulos",{"ID_Vaga","Orgao","Tipo_Publicacao","Vinculo","Periodicidade","Categoria","Moeda","Modalidade","Localidade","Localidade_Detalhe","Horario_Jornada","Descricao","Requisitos","Habilidades","Atualizacao","Limite_Candidatura"}),
    ComAmplitude = Table.AddColumn(Rotulos,"Amplitude_Salarial",each Number.Round([Salario_Max]-[Salario_Min],2),type number),
    ComPontoMedio = Table.AddColumn(ComAmplitude,"Ponto_Medio_Faixa",each Number.Round(([Salario_Min]+[Salario_Max])/2,2),type number),
    ComMes = Table.AddColumn(ComPontoMedio,"Mes_Publicacao",each Date.StartOfMonth([Data_Publicacao]),type date),
    ComQualidade = Table.AddColumn(ComMes,"Observacao_Qualidade",each Text.Combine(List.RemoveNulls({
        if not List.Contains(lst_Publicacoes,fnValorOficial([Tipo_Publicacao_Original],lst_Publicacoes)) then "Publicação fora da lista" else null,
        if not List.Contains(lst_Vinculos,fnValorOficial([Vinculo_Original],lst_Vinculos)) then "Vínculo fora da lista" else null,
        if not List.Contains(lst_Frequencias,fnValorOficial([Frequencia_Original],lst_Frequencias)) then "Periodicidade fora da lista" else null,
        if [Habilidades_Originais]=null then "Habilidades não informadas" else null,
        if [Salario_Min]=0 then "Salário zero informado na fonte" else null}),"; "),type text),
    CamposTexto = {"Fonte","Fonte_Dados","Arquivo_Origem","ID_Registro_FaseI","ID_Vaga","Cod_Orgao","Orgao","Cod_Cargo","Cargo","Titulo","Categoria","Tipo_Publicacao","Moeda","Periodicidade","Modalidade","Vinculo","Localidade","Localidade_Detalhe","Horario_Jornada","Descricao","Requisitos","Habilidades","Observacao_Qualidade","ID_Cenario"},
    TiposFinais = Table.TransformColumnTypes(ComQualidade,List.Transform(CamposTexto,each {_,type text}) & {{"Quantidade",Int64.Type},{"Salario_Min",type number},{"Salario_Max",type number},{"Amplitude_Salarial",type number},{"Ponto_Medio_Faixa",type number},{"Data_Publicacao",type date},{"Hora_Atendimento_Tratada",type time},{"Mes_Publicacao",type date},{"Atualizacao",type date},{"Limite_Candidatura",type date},{"Linha_Origem",Int64.Type},{"Linha_FaseI",Int64.Type}}),
    FormatoFinal = Table.SelectColumns(TiposFinais,{"Fonte","Fonte_Dados","Arquivo_Origem","Linha_Origem","ID_Registro_FaseI","Linha_FaseI","ID_Vaga","Cod_Orgao","Orgao","Cod_Cargo","Cargo","Titulo","Categoria","Tipo_Publicacao","Quantidade","Salario_Min","Salario_Max","Amplitude_Salarial","Ponto_Medio_Faixa","Moeda","Periodicidade","Data_Publicacao","Hora_Atendimento_Tratada","Mes_Publicacao","Atualizacao","Limite_Candidatura","Modalidade","Vinculo","Localidade","Localidade_Detalhe","Horario_Jornada","Descricao","Requisitos","Habilidades","Observacao_Qualidade","ID_Cenario"}),
    // O primeiro descarte efetivo define um único motivo por registro.
    RejeicoesDaEtapa = (antes as table,depois as table,motivo as function) as table =>
        let Anti=Table.NestedJoin(antes,{"Arquivo_Origem","Linha_Origem"},depois,{"Arquivo_Origem","Linha_Origem"},"Aceita",JoinKind.LeftAnti),
            Base=Table.RemoveColumns(Anti,{"Aceita"}),
            ComMotivo=Table.AddColumn(Base,"Motivo",each motivo(_),type text)
        in Table.SelectColumns(ComMotivo,{"Arquivo_Origem","Linha_Origem","Motivo"}),
    Descartes = Table.Combine({
        RejeicoesDaEtapa(Origem,SemLinhasEmBranco,each "Linha em branco"),
        RejeicoesDaEtapa(SemLinhasEmBranco,FontesConhecidas,each "Fonte não reconhecida"),
        RejeicoesDaEtapa(FontesConhecidas,SemIDVazio,each "ID da vaga vazio"),
        RejeicoesDaEtapa(SemIDVazio,SemQtdNulaZero,each if [Quantidade_Original]=null then "Quantidade vazia" else "Quantidade zero"),
        RejeicoesDaEtapa(OrdemBruta,SemDuplicatasExatas,each "Linha duplicada exata"),
        RejeicoesDaEtapa(DatasHoras,SemDataInvalida,each "Data inválida"),
        RejeicoesDaEtapa(SemDataInvalida,NoPeriodo,each "Data fora do período"),
        RejeicoesDaEtapa(NoPeriodo,SemHoraInvalida,each "Hora inválida"),
        RejeicoesDaEtapa(Numeros,SemErrosNumericos,each if [Quantidade]=null then "Quantidade não numérica" else "Salário ausente ou não numérico"),
        RejeicoesDaEtapa(SemErrosNumericos,QuantidadeInteira,each "Quantidade fracionária"),
        RejeicoesDaEtapa(QuantidadeInteira,QuantidadePositiva,each if [Quantidade]=0 then "Quantidade zero" else "Quantidade negativa"),
        RejeicoesDaEtapa(QuantidadePositiva,FaixaValida,each "Faixa salarial inválida"),
        RejeicoesDaEtapa(ExpandeOrgao,ComOrgao,each "Órgão sem correspondência"),
        RejeicoesDaEtapa(ExpandeCargo,ComCargo,each "Cargo não cadastrado"),
        RejeicoesDaEtapa(OrdemOficial,SemDuplicatas,each "Linha duplicada pela chave oficial")}),
    Etapas = [Origem=Origem,SemLinhasEmBranco=SemLinhasEmBranco,FontesConhecidas=FontesConhecidas,SemIDVazio=SemIDVazio,
        SemQtdNulaZero=SemQtdNulaZero,SemDuplicatasExatas=SemDuplicatasExatas,DatasHoras=DatasHoras,SemDataInvalida=SemDataInvalida,
        NoPeriodo=NoPeriodo,SemHoraInvalida=SemHoraInvalida,Numeros=Numeros,SemErrosNumericos=SemErrosNumericos,
        QuantidadeInteira=QuantidadeInteira,QuantidadePositiva=QuantidadePositiva,FaixaValida=FaixaValida,
        ExpandeOrgao=ExpandeOrgao,ComOrgao=ComOrgao,ExpandeCargo=ExpandeCargo,ComCargo=ComCargo,SemDuplicatas=SemDuplicatas,FormatoFinal=FormatoFinal],
    Contagens = #table(type table [Base=text,Etapa=text,Linhas=Int64.Type],List.Transform(Record.FieldNames(Etapas),(n)=>{"Vagas",n,Table.RowCount(Record.Field(Etapas,n))}))
in [Aceitas=FormatoFinal,Descartes=Descartes,Contagens=Contagens,Etapas=Etapas]
